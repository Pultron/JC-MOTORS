{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JC Motors Cotizador",
  "version": "0.1.4",
  "identifier": "mx.jcmotors.cotizador",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JC Motors Cotizador",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/jc-motors-shortcut.ico": "jc-motors-logo-v2.ico"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "category": "Business",
    "shortDescription": "Gestión de cotizaciones de JC Motors"
  }
}
